# =========================================================================
# Nassau Roofing & Remodeling — .htaccess
# Serves clean, extensionless URLs (e.g. /about/ instead of /about.html)
# from the folder+index.html structure, redirects old .html URLs for
# backward compatibility / SEO link-equity, and applies standard hardening.
# Requires Apache with mod_rewrite, mod_dir, mod_headers, mod_deflate,
# mod_expires enabled (all standard on shared hosting).
# =========================================================================

DirectoryIndex index.html

RewriteEngine On

# -------------------------------------------------------------------------
# 1. Force HTTPS
# -------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -------------------------------------------------------------------------
# 2. Force the canonical "www" host
#    (drop this block, or flip it to strip "www", to match whichever host
#    you actually want to be canonical once the site is live)
# -------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^nassauroofingexperts\.com$ [NC]
RewriteRule ^ https://www.nassauroofingexperts.com%{REQUEST_URI} [L,R=301]

# -------------------------------------------------------------------------
# 3. 301 redirect legacy flat "*.html" URLs to their new clean folder URLs
#    (preserves SEO value / bookmarks / backlinks from the previous export)
# -------------------------------------------------------------------------
RewriteRule ^index\.html$ /  [L,R=301]
RewriteRule ^about\.html$ /about/ [L,R=301]
RewriteRule ^roofing-services\.html$ /roofing-services/ [L,R=301]
RewriteRule ^contact\.html$ /contact/ [L,R=301]
RewriteRule ^kitchen-remodeling\.html$ /kitchen-remodeling/ [L,R=301]
RewriteRule ^bathroom-remodeling\.html$ /bathroom-remodeling/ [L,R=301]
RewriteRule ^home-remodeling\.html$ /home-remodeling/ [L,R=301]
RewriteRule ^home-extensions-dormer-additions\.html$ /home-extensions-dormer-additions/ [L,R=301]
RewriteRule ^basement-remodeling\.html$ /basement-remodeling/ [L,R=301]
RewriteRule ^remodeling-services\.html$ /remodeling-services/ [L,R=301]

# -------------------------------------------------------------------------
# 4. Redirect any other bare "/page" or "/page.html" request (no trailing
#    slash) to the trailing-slash folder URL, when that folder exists.
#    Keeps things tidy if a link is ever typed/pasted without the slash.
# -------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([^/]+)$ /$1/ [L,R=301]

# -------------------------------------------------------------------------
# 5. Remove trailing "index.html" from URLs typed explicitly
#    (/about/index.html -> /about/)
# -------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# -------------------------------------------------------------------------
# 6. Security / hygiene
# -------------------------------------------------------------------------
Options -Indexes
Options -MultiViews

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# -------------------------------------------------------------------------
# 7. Compression
# -------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------------------------------------------
# 8. Browser caching
# -------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# -------------------------------------------------------------------------
# 9. Custom 404 (optional — point this at a real 404 page if you add one)
# -------------------------------------------------------------------------
# ErrorDocument 404 /404/
